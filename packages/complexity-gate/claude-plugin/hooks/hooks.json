{
  "description": "Check edited and changed functions with complexity-gate.",
  "hooks": {
    "PostToolUse": [{
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [{ "type": "command", "command": "complexity-gate hook claude" }]
    }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "complexity-gate hook claude" }]
    }]
  }
}

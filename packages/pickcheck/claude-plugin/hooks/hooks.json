{
  "description": "Check edited and changed functions with pickcheck.",
  "hooks": {
    "PostToolUse": [{
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [{ "type": "command", "command": "pickcheck hook claude" }]
    }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "pickcheck hook claude" }]
    }]
  }
}
